# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash. Must match the GitHub OAuth app's callback base.
BASE_URL=http://localhost:3000
PORT=3000

# From https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               same as BASE_URL
#   Authorization callback URL: BASE_URL + /auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed into /admin.html
ADMIN_GITHUB_USERS=your-github-username

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where datasets.json is stored. Point this at a persistent disk in production.
# DATA_DIR=/var/data
